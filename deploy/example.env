# Copy to deploy/staging.env and deploy/production.env (git-ignored) and fill in.
# Used by bin/deploy.sh and bin/rollback.sh (docs/deployment.md).

# SSH login, e.g. kinsta-user@203.0.113.5 (Kinsta and most managed hosts show it in their dashboard).
DEPLOY_SSH=user@host.example.com
DEPLOY_SSH_PORT=22
# WordPress root on the server (the folder with wp-config.php or its parent's public folder).
DEPLOY_PATH=/www/example_123/public
# Public URL, for the smoke test.
DEPLOY_URL=https://staging.example.com
# WP-CLI on the server.
DEPLOY_WP=wp
# Pre-deploy database dumps and code copies; keep it outside the web root.
DEPLOY_BACKUP_DIR=/www/example_123/deploy-backups
# Page cache / CDN purge after a deploy. Kinsta: "wp kinsta cache purge --all";
# W3 Total Cache: "wp w3-total-cache flush all". Leave empty if none.
DEPLOY_PURGE_CMD=
