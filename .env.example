# Copy to .env and adjust. .env is git-ignored; never commit real credentials.

# Local Docker stack (docker-compose.yml)
WP_PORT=8080
WP_DEBUG=1
DB_NAME=wordpress
DB_USER=wordpress
DB_PASSWORD=wordpress
DB_ROOT_PASSWORD=root

# Local admin account created by `make install`
WP_ADMIN_USER=admin
WP_ADMIN_PASSWORD=password
WP_ADMIN_EMAIL=admin@example.com

# Third-party API keys go here once a data source is chosen (see docs/data-sources.md).
# In production, define them as wp-config.php constants or host environment variables instead.
