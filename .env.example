# Copy to .env and adjust. .env is git-ignored; never commit real credentials.

# Local Docker stack (docker-compose.yml)
WP_PORT=8080
# Local HTTPS port, used after `make https` (README, "Local HTTPS").
WP_HTTPS_PORT=8443
WP_DEBUG=1
DB_NAME=wordpress
DB_USER=wordpress
DB_PASSWORD=wordpress
DB_ROOT_PASSWORD=root

# Local admin account created by `make install`
WP_ADMIN_USER=admin
WP_ADMIN_PASSWORD=password
WP_ADMIN_EMAIL=admin@example.com

# Third-party API keys (see docs/data-sources.md). In production, define them as
# wp-config.php constants or host environment variables instead.

# Google Places API (New) key for `wp guam-restaurants discover` and the daily discover
# job (docs/scheduling.md). Restrict it to the Places API in Google Cloud. Leave empty
# to disable discovery; then only OpenStreetMap adds restaurants.
GUAM_RESTAURANTS_GOOGLE_PLACES_KEY=

# Hugging Face access token for `make fsq-extract` (Foursquare Open Source Places,
# docs/run-fsq-import.md). Read-only token; the account must accept the dataset's
# conditions once. Only the extract uses it; WordPress never sees it.
HF_TOKEN=
FSQ_RELEASE=

# Ratings (wp guam-restaurants match-ratings, the ratings block and shortcode).
# Yelp and Foursquare ratings have no free tier, so with the $0 caps they never show.
GUAM_RESTAURANTS_YELP_API_KEY=
GUAM_RESTAURANTS_FOURSQUARE_API_KEY=
# Hard caps in US dollars: per matching or refresh run, and per month for live page-view calls.
# 0 (the default) means free calls only: each source's free monthly allowance, then stop.
GUAM_RESTAURANTS_RATINGS_RUN_CAP_USD=0
GUAM_RESTAURANTS_RATINGS_MONTHLY_CAP_USD=0
# Folder URL of Yelp's official star images (regular_4_half.png, ...) and yelp_logo.png.
# Yelp ratings stay hidden until this is set.
GUAM_RESTAURANTS_YELP_ASSETS_URL=
# Optional official logo images; without them the text "Google Maps" / "Powered by Foursquare" is shown.
GUAM_RESTAURANTS_GOOGLE_MAPS_LOGO_URL=
GUAM_RESTAURANTS_FOURSQUARE_LOGO_URL=

# Monitoring (docs/scheduling.md).
# Who gets missed-job and closure alerts; empty means the site admin email.
GUAM_RESTAURANTS_ALERT_EMAIL=
# Email when one run queues more than this many restaurants as possibly closed.
GUAM_RESTAURANTS_CLOSURE_ALERT_THRESHOLD=5
# "server" when a real crontab runs `wp guam-restaurants run-job`; "wp-cron" (default) otherwise.
GUAM_RESTAURANTS_CRON_MODE=wp-cron
# Yelp status checks are paid (no free tier); 1 enables them, within the ratings caps.
GUAM_RESTAURANTS_YELP_STATUS_CHECKS=0

# Optional overrides for `wp guam-restaurants import-osm`.
# GUAM_RESTAURANTS_OVERPASS_URL=https://overpass-api.de/api/interpreter
# Used only after the main instance fails every retry; "none" turns it off.
# GUAM_RESTAURANTS_OVERPASS_FALLBACK_URL=https://overpass.kumi.systems/api/interpreter
# GUAM_RESTAURANTS_USER_AGENT="guam-restaurants-core/0.1.0 (+https://your-site.example)"

# Public site maps.
# Vector style for the map page and restaurant maps. Empty uses OpenFreeMap
# (free, no key, attribution shown on the map). For a paid provider with an
# SLA, paste its style URL here, e.g. MapTiler: https://api.maptiler.com/maps/streets-v2/style.json?key=...
GUAM_RESTAURANTS_MAP_STYLE_URL=
# Google Maps Embed API key (free). Only used on restaurant pages that show
# Google ratings, which must not sit next to a non-Google map. Without it those
# pages show no map, only a directions link. Restrict the key by HTTP referrer.
GUAM_RESTAURANTS_GOOGLE_MAPS_EMBED_KEY=
# Set to 1 to let owners verify a listing claim with a code texted to the
# restaurant's listed phone. Off by default (texts cost money) and needs an SMS
# sender hooked to guam_restaurants_send_claim_sms (docs/billing.md, "Claims").
GUAM_RESTAURANTS_CLAIM_PHONE_CODES=

# Analytics (docs/seo-and-analytics.md). "matomo" (recommended) or "umami";
# empty prints no tracker. Both run without cookies.
GUAM_RESTAURANTS_ANALYTICS=
# matomo.js (Matomo for WordPress: /wp-content/uploads/matomo/matomo.js) or Umami's script.js.
GUAM_RESTAURANTS_ANALYTICS_SCRIPT_URL=
# Matomo only: tracking endpoint (Matomo for WordPress: /wp-json/matomo/v1/hit/).
GUAM_RESTAURANTS_ANALYTICS_ENDPOINT=
# Matomo site ID or Umami website ID.
GUAM_RESTAURANTS_ANALYTICS_SITE_ID=
# The site's own profile URLs (Google Business Profile, Facebook...), comma-separated,
# for the home page's Organization structured data.
GUAM_RESTAURANTS_BRAND_PROFILES=

# Weekly newsletter (docs/monetization.md §8). SendFox personal access token;
# the API needs a paid SendFox plan. Without it, Restaurants > Newsletter shows
# HTML to paste. Drafts are never scheduled or sent automatically.
GUAM_RESTAURANTS_SENDFOX_TOKEN=
# Optional SendFox list ID the draft is addressed to.
GUAM_RESTAURANTS_SENDFOX_LIST_ID=
# Sender; defaults to the site name and admin email.
GUAM_RESTAURANTS_NEWSLETTER_FROM_NAME=
GUAM_RESTAURANTS_NEWSLETTER_FROM_EMAIL=

# Production hardening (docs/security.md, docs/deployment.md §2).
# 0 turns off the security headers the plugin sends (when the server or CDN sends them).
GUAM_RESTAURANTS_SECURITY_HEADERS=1
# 1 adds Strict-Transport-Security on HTTPS. Only once HTTPS works on every host name.
GUAM_RESTAURANTS_HSTS=0
# Content-Security-Policy: report-only (default), enforce, or off.
GUAM_RESTAURANTS_CSP=report-only
# Server variable holding the visitor's real IP behind a CDN, e.g. HTTP_CF_CONNECTING_IP.
# Only set it when the origin accepts traffic from the CDN alone (docs/security.md §5).
GUAM_RESTAURANTS_CLIENT_IP_HEADER=
# 1 sends administrators without two-factor sign-in to their profile (needs the Two Factor plugin).
GUAM_RESTAURANTS_REQUIRE_ADMIN_2FA=0
# Upload size cap in MB (the server's own limit still applies when lower).
GUAM_RESTAURANTS_MAX_UPLOAD_MB=10
# 1 keeps XML-RPC on. Off by default; nothing on this site uses it.
GUAM_RESTAURANTS_ALLOW_XMLRPC=0
# Custom table upgrades: auto (first request after a deploy) or cli (only `wp guam-restaurants db upgrade`).
GUAM_RESTAURANTS_DB_UPGRADE=auto
