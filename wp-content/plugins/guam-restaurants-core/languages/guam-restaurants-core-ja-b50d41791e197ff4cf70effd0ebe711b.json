{"translation-revision-date":"2026-10-20T23:36:41+00:00","generator":"WP-CLI\/2.12.0","source":"assets\/corrections\/corrections.js","domain":"messages","locale_data":{"messages":{"":{"domain":"messages","lang":"ja","plural-forms":"nplurals=1; plural=0;"},"Restaurant":["\u30ec\u30b9\u30c8\u30e9\u30f3"],"Email":["\u30e1\u30fc\u30eb"],"Choose the restaurant from the list.":["\u4e00\u89a7\u304b\u3089\u30ec\u30b9\u30c8\u30e9\u30f3\u3092\u9078\u3093\u3067\u304f\u3060\u3055\u3044\u3002"],"Your request could not be sent. Please try again.":["\u30ea\u30af\u30a8\u30b9\u30c8\u3092\u9001\u4fe1\u3067\u304d\u307e\u305b\u3093\u3067\u3057\u305f\u3002\u3082\u3046\u4e00\u5ea6\u304a\u8a66\u3057\u304f\u3060\u3055\u3044\u3002"],"Privacy policy":["\u30d7\u30e9\u30a4\u30d0\u30b7\u30fc\u30dd\u30ea\u30b7\u30fc"],"(required)":["\uff08\u5fc5\u9808\uff09"],"Your name":["\u304a\u540d\u524d"],"The form could not be loaded. Please reload the page.":["\u30d5\u30a9\u30fc\u30e0\u3092\u8aad\u307f\u8fbc\u3081\u307e\u305b\u3093\u3067\u3057\u305f\u3002\u30da\u30fc\u30b8\u3092\u518d\u8aad\u307f\u8fbc\u307f\u3057\u3066\u304f\u3060\u3055\u3044\u3002"],"No restaurant with that name.":["\u305d\u306e\u540d\u524d\u306e\u30ec\u30b9\u30c8\u30e9\u30f3\u306f\u3042\u308a\u307e\u305b\u3093\u3002"],"What would you like to do?":["\u3054\u5e0c\u671b\u306e\u5185\u5bb9\u306f\uff1f"],"Choose one":["1 \u3064\u9078\u3093\u3067\u304f\u3060\u3055\u3044"],"Send request":["\u30ea\u30af\u30a8\u30b9\u30c8\u3092\u9001\u4fe1"],"We use your email address only to reply to this request. Nothing you send here is published.":["\u30e1\u30fc\u30eb\u30a2\u30c9\u30ec\u30b9\u306f\u3053\u306e\u30ea\u30af\u30a8\u30b9\u30c8\u3078\u306e\u8fd4\u4fe1\u306b\u306e\u307f\u4f7f\u7528\u3057\u307e\u3059\u3002\u3053\u3053\u3067\u9001\u4fe1\u3055\u308c\u305f\u5185\u5bb9\u306f\u516c\u958b\u3055\u308c\u307e\u305b\u3093\u3002"],"How we handle corrections":["\u8a02\u6b63\u306e\u53d6\u308a\u6271\u3044\u306b\u3064\u3044\u3066"],"Reason for removal":["\u524a\u9664\u306e\u7406\u7531"],"Choose a reason":["\u7406\u7531\u3092\u9078\u3093\u3067\u304f\u3060\u3055\u3044"],"Tell us more":["\u8a73\u3057\u304f\u6559\u3048\u3066\u304f\u3060\u3055\u3044"],"What needs changing?":["\u5909\u66f4\u304c\u5fc5\u8981\u306a\u9805\u76ee\u306f\uff1f"],"What should the listing say?":["\u63b2\u8f09\u5185\u5bb9\u3092\u3069\u3046\u5909\u3048\u308c\u3070\u3088\u3044\u3067\u3059\u304b\uff1f"],"What is wrong, and what is correct?":["\u4f55\u304c\u8aa4\u308a\u3067\u3001\u6b63\u3057\u304f\u306f\u4f55\u3067\u3059\u304b\uff1f"],"We reply within %d days.":["%d \u65e5\u4ee5\u5185\u306b\u3054\u8fd4\u4fe1\u3057\u307e\u3059\u3002"],"A closed restaurant is marked closed rather than removed. Removing a listing never adds any note to the site.":["\u9589\u5e97\u3057\u305f\u30ec\u30b9\u30c8\u30e9\u30f3\u306f\u524a\u9664\u305b\u305a\u3001\u9589\u5e97\u3068\u8868\u793a\u3057\u307e\u3059\u3002\u63b2\u8f09\u3092\u524a\u9664\u3057\u3066\u3082\u3001\u30b5\u30a4\u30c8\u306b\u6ce8\u8a18\u304c\u8ffd\u52a0\u3055\u308c\u308b\u3053\u3068\u306f\u3042\u308a\u307e\u305b\u3093\u3002"],"Type at least two letters of the restaurant name and pick it from the list.":["\u30ec\u30b9\u30c8\u30e9\u30f3\u540d\u3092 2 \u6587\u5b57\u4ee5\u4e0a\u5165\u529b\u3057\u3066\u3001\u4e00\u89a7\u304b\u3089\u9078\u3093\u3067\u304f\u3060\u3055\u3044\u3002"],"Where can we confirm this?":["\u3069\u3053\u3067\u78ba\u8a8d\u3067\u304d\u307e\u3059\u304b\uff1f"],"For example, a link to the restaurant's website or social media page, or \"sign on the door\".":["\u4f8b\uff1a\u30ec\u30b9\u30c8\u30e9\u30f3\u306e\u30a6\u30a7\u30d6\u30b5\u30a4\u30c8\u3084 SNS \u30da\u30fc\u30b8\u3078\u306e\u30ea\u30f3\u30af\u3001\u307e\u305f\u306f\u300c\u30c9\u30a2\u306e\u8cbc\u308a\u7d19\u300d\u3002"],"Your connection to the restaurant":["\u30ec\u30b9\u30c8\u30e9\u30f3\u3068\u306e\u3054\u95a2\u4fc2"],"Your request could not be sent. Please check your connection and try again.":["\u30ea\u30af\u30a8\u30b9\u30c8\u3092\u9001\u4fe1\u3067\u304d\u307e\u305b\u3093\u3067\u3057\u305f\u3002\u63a5\u7d9a\u3092\u78ba\u8a8d\u3057\u3066\u3001\u3082\u3046\u4e00\u5ea6\u304a\u8a66\u3057\u304f\u3060\u3055\u3044\u3002"]}}}