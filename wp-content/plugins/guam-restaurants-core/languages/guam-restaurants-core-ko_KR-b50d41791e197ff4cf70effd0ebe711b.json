{"translation-revision-date":"2026-10-21T17:25:40+00:00","generator":"WP-CLI\/2.12.0","source":"assets\/corrections\/corrections.js","domain":"messages","locale_data":{"messages":{"":{"domain":"messages","lang":"ko_KR","plural-forms":"nplurals=1; plural=0;"},"Restaurant":["\uc2dd\ub2f9"],"Email":["\uc774\uba54\uc77c"],"Choose the restaurant from the list.":["\ubaa9\ub85d\uc5d0\uc11c \uc2dd\ub2f9\uc744 \uc120\ud0dd\ud574 \uc8fc\uc138\uc694."],"Your request could not be sent. Please try again.":["\uc694\uccad\uc744 \ubcf4\ub0b4\uc9c0 \ubabb\ud588\uc2b5\ub2c8\ub2e4. \ub2e4\uc2dc \uc2dc\ub3c4\ud574 \uc8fc\uc138\uc694."],"Privacy policy":["\uac1c\uc778\uc815\ubcf4 \ucc98\ub9ac\ubc29\uce68"],"(required)":["(\ud544\uc218)"],"Your name":["\uc774\ub984"],"The form could not be loaded. Please reload the page.":["\uc591\uc2dd\uc744 \ubd88\ub7ec\uc624\uc9c0 \ubabb\ud588\uc2b5\ub2c8\ub2e4. \ud398\uc774\uc9c0\ub97c \uc0c8\ub85c \uace0\uccd0 \uc8fc\uc138\uc694."],"No restaurant with that name.":["\uadf8 \uc774\ub984\uc758 \uc2dd\ub2f9\uc774 \uc5c6\uc2b5\ub2c8\ub2e4."],"What would you like to do?":["\ubb34\uc5c7\uc744 \ud558\uc2dc\uaca0\uc5b4\uc694?"],"Choose one":["\ud558\ub098\ub97c \uc120\ud0dd\ud558\uc138\uc694"],"Send request":["\uc694\uccad \ubcf4\ub0b4\uae30"],"We use your email address only to reply to this request. Nothing you send here is published.":["\uc774\uba54\uc77c \uc8fc\uc18c\ub294 \uc774 \uc694\uccad\uc5d0 \ub2f5\ubcc0\ud560 \ub54c\ub9cc \uc0ac\uc6a9\ud569\ub2c8\ub2e4. \uc5ec\uae30\uc5d0\uc11c \ubcf4\ub0b8 \ub0b4\uc6a9\uc740 \uacf5\uac1c\ub418\uc9c0 \uc54a\uc2b5\ub2c8\ub2e4."],"How we handle corrections":["\uc815\uc815 \ucc98\ub9ac \ubc29\ubc95"],"Reason for removal":["\uc0ad\uc81c \uc0ac\uc720"],"Choose a reason":["\uc0ac\uc720\ub97c \uc120\ud0dd\ud558\uc138\uc694"],"Tell us more":["\uc790\uc138\ud788 \uc54c\ub824 \uc8fc\uc138\uc694"],"What needs changing?":["\ubb34\uc5c7\uc744 \ubc14\uafd4\uc57c \ud558\ub098\uc694?"],"What should the listing say?":["\ub4f1\ub85d \uc815\ubcf4\ub97c \uc5b4\ub5bb\uac8c \ubc14\uafd4\uc57c \ud558\ub098\uc694?"],"What is wrong, and what is correct?":["\ubb34\uc5c7\uc774 \uc798\ubabb\ub418\uc5c8\uace0, \ubb34\uc5c7\uc774 \ub9de\ub098\uc694?"],"We reply within %d days.":["%d\uc77c \uc774\ub0b4\uc5d0 \ub2f5\ubcc0\ub4dc\ub9bd\ub2c8\ub2e4."],"A closed restaurant is marked closed rather than removed. Removing a listing never adds any note to the site.":["\ud3d0\uc5c5\ud55c \uc2dd\ub2f9\uc740 \uc0ad\uc81c\ud558\uc9c0 \uc54a\uace0 \ud3d0\uc5c5\uc73c\ub85c \ud45c\uc2dc\ud569\ub2c8\ub2e4. \ub4f1\ub85d\uc744 \uc0ad\uc81c\ud574\ub3c4 \uc0ac\uc774\ud2b8\uc5d0 \ubcc4\ub3c4 \uc548\ub0b4\uac00 \ub0a8\uc9c0 \uc54a\uc2b5\ub2c8\ub2e4."],"Type at least two letters of the restaurant name and pick it from the list.":["\uc2dd\ub2f9 \uc774\ub984\uc744 \ub450 \uae00\uc790 \uc774\uc0c1 \uc785\ub825\ud558\uace0 \ubaa9\ub85d\uc5d0\uc11c \uc120\ud0dd\ud574 \uc8fc\uc138\uc694."],"Where can we confirm this?":["\uc5b4\ub514\uc5d0\uc11c \ud655\uc778\ud560 \uc218 \uc788\ub098\uc694?"],"For example, a link to the restaurant's website or social media page, or \"sign on the door\".":["\uc608: \uc2dd\ub2f9 \uc6f9\uc0ac\uc774\ud2b8\ub098 \uc18c\uc15c \ubbf8\ub514\uc5b4 \ud398\uc774\uc9c0 \ub9c1\ud06c, \ub610\ub294 \"\ubb38\uc5d0 \ubd99\uc740 \uc548\ub0b4\ubb38\"."],"Your connection to the restaurant":["\uc2dd\ub2f9\uacfc\uc758 \uad00\uacc4"],"Your request could not be sent. Please check your connection and try again.":["\uc694\uccad\uc744 \ubcf4\ub0b4\uc9c0 \ubabb\ud588\uc2b5\ub2c8\ub2e4. \uc5f0\uacb0\uc744 \ud655\uc778\ud55c \ub4a4 \ub2e4\uc2dc \uc2dc\ub3c4\ud574 \uc8fc\uc138\uc694."]}}}