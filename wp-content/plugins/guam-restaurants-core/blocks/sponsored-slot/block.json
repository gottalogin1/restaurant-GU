{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "guam-restaurants/sponsored-slot",
	"version": "0.2.0",
	"title": "Sponsored slot",
	"category": "widgets",
	"icon": "megaphone",
	"description": "Ads of one product that target this page, each labeled Sponsored, outside the regular results. Prints nothing when no ad is running.",
	"textdomain": "guam-restaurants-core",
	"attributes": {
		"product": {
			"type": "string",
			"enum": [
				"banner",
				"featured_listing",
				"category_sponsor",
				"leaderboard"
			],
			"default": "banner"
		},
		"count": {
			"type": "integer",
			"default": 1
		}
	},
	"supports": {
		"html": false,
		"align": [
			"wide",
			"full"
		]
	},
	"usesContext": [
		"postId",
		"postType"
	],
	"editorScript": "guam-restaurants-site-blocks-editor"
}
